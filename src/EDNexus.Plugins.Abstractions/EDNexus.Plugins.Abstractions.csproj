<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      This assembly is the stable contract surface third-party plugins compile against.
      It must never reference EDNexus.Core (or Avalonia) — see AGENTS.md and issue #52.
    -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EDNexus.Plugins.Abstractions.Tests" />
  </ItemGroup>

</Project>
