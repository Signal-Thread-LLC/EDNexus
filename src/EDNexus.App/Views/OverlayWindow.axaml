<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EDNexus.App.Views.OverlayWindow"
        Title="EDNexus Overlay"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowActivated="False"
        ShowInTaskbar="False"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        Focusable="False">
  <!-- Click-through is applied in code-behind (Win32 WS_EX_TRANSPARENT) once the native handle
       exists, so the game underneath always keeps mouse/keyboard focus. -->
  <Border Background="{StaticResource OverlayScrim}" CornerRadius="8" Padding="14" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
          MinWidth="230">
    <StackPanel Spacing="5">
      <TextBlock Text="EDNEXUS" Foreground="{StaticResource AmberBrush}" FontSize="11" FontWeight="Bold" LetterSpacing="2" />
      <TextBlock x:Name="SystemLine" Foreground="{StaticResource Ink}" FontSize="13" />
      <TextBlock x:Name="NextJumpLine" Foreground="{StaticResource Ink}" FontSize="13" IsVisible="False" />
      <TextBlock x:Name="FuelLine" Foreground="{StaticResource Ink}" FontSize="13" />
      <TextBlock x:Name="BioLine" Foreground="{StaticResource Good}" FontSize="13" IsVisible="False" />
      <TextBlock x:Name="ShortfallHeader" Text="COLONISATION SHORTFALL" Foreground="{StaticResource InkDim}" FontSize="10"
                 FontWeight="SemiBold" LetterSpacing="1" Margin="0,4,0,0" IsVisible="False" />
      <ItemsControl x:Name="ShortfallList" IsVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="{StaticResource Ink}" FontSize="12" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
