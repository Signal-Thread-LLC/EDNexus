<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EDNexus.App.ViewModels"
        x:Class="EDNexus.App.Views.WarBoardWindow"
        x:DataType="vm:MissionsCardViewModel"
        Title="EDNexus — War Board"
        Icon="/Assets/ednexus.png"
        Width="720" Height="640" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0C">

  <Window.Resources>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFF07100" />
    <SolidColorBrush x:Key="CardBorder" Color="#242830" />
    <SolidColorBrush x:Key="Ink" Color="#E7E9EE" />
    <SolidColorBrush x:Key="InkDim" Color="#8A909C" />
    <SolidColorBrush x:Key="Good" Color="#FF5FD08B" />
    <SolidColorBrush x:Key="Bad" Color="#FFE0654F" />
  </Window.Resources>

  <!-- Bound to the live MissionsCardViewModel, so this stays in step with the dashboard card. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#101216" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="0,0,0,1" Padding="16,12">
      <StackPanel>
        <TextBlock Text="WAR BOARD" Foreground="{StaticResource AmberBrush}" FontSize="12"
                   FontWeight="SemiBold" LetterSpacing="2" />
        <TextBlock Text="{Binding TotalPayout}" Foreground="{StaticResource Ink}" FontSize="14"
                   Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CapNote}" Foreground="{StaticResource InkDim}" FontSize="12"
                   Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="No missions held." Foreground="{StaticResource InkDim}"
               FontSize="13" Margin="16,16" IsVisible="{Binding NoMissions}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding HasMissions}">
      <ItemsControl ItemsSource="{Binding AllMissions}" Margin="16,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MissionLine">
            <Border Background="#101216" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="14,10" Margin="0,0,0,8">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource Ink}"
                             FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Reward}" Foreground="{StaticResource Good}"
                             FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding GiverFaction}" Foreground="{StaticResource InkDim}" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Target}" Foreground="{StaticResource AmberBrush}" FontSize="12" />
                  <TextBlock Text="Ready to hand in" Foreground="{StaticResource Good}" FontSize="12"
                             FontWeight="SemiBold" IsVisible="{Binding ReadyToTurnIn}" />
                  <TextBlock Text="{Binding ExpiryNote}" Foreground="{StaticResource InkDim}" FontSize="12"
                             IsVisible="{Binding HasExpiryNote}" />
                  <TextBlock Text="{Binding ExpiryNote}" Foreground="{StaticResource Bad}" FontSize="12"
                             FontWeight="SemiBold" IsVisible="{Binding IsUrgent}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
