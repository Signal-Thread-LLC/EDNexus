<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      The plugin host: manifest parsing/validation and .ednplugin packaging (#54), with
      discovery, AssemblyLoadContext loading, lifecycle and permissions to follow (#55-#57).
      Plugins never reference this assembly — they compile against EDNexus.Plugins.Abstractions.
    -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EDNexus.Plugins.Hosting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EDNexus.Plugins.Abstractions\EDNexus.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PLUGIN_FORMAT.md" />
    <None Include="plugin.sample.json" />
  </ItemGroup>

</Project>
